# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## Build generated
build/
DerivedData/

## Various settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/

## Other
*.moved-aside
*.xccheckout
*.xcscmblueprint

## Obj-C/Swift specific
*.hmap

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved
.swiftpm/

## CocoaPods
Pods/
# Add this line if you want to avoid checking in source code from Pods.
# Note: Many teams prefer to commit Pods for reproducible builds.

## Carthage
Carthage/Build/

## Accio dependency management
Dependencies/
.accio/

## fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/readme.md

## Code coverage
*.xccovreport
*.xccovarchive

## Xcode Patch
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno

## Archives
*.xcarchive

## iOS specific
*.ipa

## macOS specific
*.dmg

## Simulator logs and device support
~/Library/Developer/Xcode/DerivedData/
~/Library/Developer/Xcode/Archives/

## SwiftLint cache
.swiftlint_cache

## SwiftFormat
.swiftformat

## SPM playground and workspace user data
*.xcuserstate

## Firebase / GoogleService files (optional, uncomment to ignore if desired)
# GoogleService-Info.plist

## Environment files
.env

## macOS Finder
.DS_Store
.AppleDouble
.LSOverride

## Icon must end with two \r
Icon

## Thumbnails
._*

